{
  "name": "@dsh-external/dsh-plugin-toggle",
  "description": "Hot-plug toggle switches for installed DSH plugins: enable/disable without restart; auto-hiding preset-switch header menu",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aorucshiea/dsh-plugin-toggle.git"
  },
  "homepage": "https://github.com/aorucshiea/dsh-plugin-toggle",
  "bugs": {
    "url": "https://github.com/aorucshiea/dsh-plugin-toggle/issues"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "hot-plug", "toggle"],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc <2",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.0 <2"
  }
}
